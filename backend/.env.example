DATABASE_URL=postgresql://postgres:TU_PASSWORD@localhost:5432/evalua_riesgos
PORT=4000
FRONTEND_ORIGIN=http://localhost:5173

# Correo (obligatorio para recuperación automática del administrador tras 3 intentos fallidos)
SMTP_HOST=smtp.ejemplo.com
SMTP_PORT=587
# true solo si el puerto usa SSL directo (p. ej. 465)
SMTP_SECURE=false
SMTP_USER=usuario_smtp
SMTP_PASS=contraseña_smtp
SMTP_FROM="Evaluación Riesgos <noreply@ejemplo.com>"
APP_PUBLIC_NAME=Sistema de Evaluación de Riesgos Laborales